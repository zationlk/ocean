4:T455,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What types of lighting products do you carry?","acceptedAnswer":{"@type":"Answer","text":"We carry a comprehensive range including LED panel lights, chandeliers, pendant lights, track lighting, outdoor flood lights, solar garden lights, LED strip lights, industrial high bay lights, and much more."}},{"@type":"Question","name":"Do you offer island-wide delivery?","acceptedAnswer":{"@type":"Answer","text":"Yes, we deliver across Sri Lanka."}},{"@type":"Question","name":"What warranty do your products come with?","acceptedAnswer":{"@type":"Answer","text":"Warranty periods range from 1 to 5 years depending on product and brand."}},{"@type":"Question","name":"Can I visit your showroom to see products in person?","acceptedAnswer":{"@type":"Answer","text":"Yes! Visit our showroom at 591, Chilaw Road, Kattuwa, Negombo."}},{"@type":"Question","name":"Do you carry smart lighting products?","acceptedAnswer":{"@type":"Answer","text":"Yes, we carry smart LED strips, smart bulbs, and dimmable lighting systems."}}]}0:["ylaX5ypUqpH572RGanFfq",[[["",{"children":["faq",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["faq",{"children":["__PAGE__",{},[["$L1",["$","$L2",null,{"props":{"params":{},"searchParams":{}},"Component":"$3"}]],null],null]},[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$4"}}],["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","faq","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}]],null],null]},["$L7",null],null],[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/99e8a618f2355389.css","precedence":"next","crossOrigin":"$undefined"}]],[null,"$L8"]]]]]
